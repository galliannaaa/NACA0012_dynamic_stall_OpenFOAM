FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    location    "0";
    object      pointDisplacement;
}

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    farfield
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    wing
    {
        type            angularOscillatingDisplacement;

        origin          (0.25 0 0);
        axis            (0 0 -1);

        angle0          0;
        amplitude       0.1745329252;
        omega           5;

        value           uniform (0 0 0);
    }

    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    frontAndBack
    {
        type            empty;
    }
}

