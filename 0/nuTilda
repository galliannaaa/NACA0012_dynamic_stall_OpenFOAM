FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform 1e-4;
    }

    outlet
    {
        type            freestream;
        freestreamValue uniform 1e-4;
    }

    farfield
    {
        type            freestream;
        freestreamValue uniform 1e-4;
    }

    wing
    {
        type            fixedValue;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}